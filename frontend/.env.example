# =============================================================================
# BRANCHAT FRONTEND CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001

# =============================================================================
# CHROME BUILT-IN AI CONFIGURATION
# =============================================================================
# BranChat uses Chrome's Built-in AI APIs for privacy-first, on-device processing
# 
# APIs Used:
# 1. Prompt API - Conversational responses (window.ai.languageModel)
# 2. Summarizer API - Branch summarization (window.ai.summarizer)
# 3. Writer API - Conversation starters (window.ai.writer)
#
# Requirements:
# - Chrome 127+ (Canary, Dev, or Beta recommended)
# - Enable flags:
#   chrome://flags/#optimization-guide-on-device-model → Enable
#   chrome://flags/#prompt-api-for-gemini-nano → Enable
# - Restart Chrome (Gemini Nano will download automatically ~1-2GB)
#
# NO API KEYS NEEDED - Chrome Built-in AI runs entirely on-device!
# -----------------------------------------------------------------------------

# Enable Chrome Built-in AI (Prompt, Summarizer, Writer APIs)
# Set to 'false' to always use server-side Gemini API
VITE_ENABLE_CHROME_AI=true

# Fallback to server when Chrome AI unavailable
# Set to 'false' to show error instead of falling back
VITE_AI_FALLBACK_TO_SERVER=true

# Show detailed Chrome AI logs in console
# Useful for debugging and verifying which API is being used
VITE_CHROME_AI_DEBUG=true

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
VITE_DEV_MODE=true
VITE_ENABLE_DEBUG_LOGS=false

# =============================================================================
# NOTES
# =============================================================================
# Chrome Built-in AI Benefits:
# ✅ Privacy: All processing happens on your device
# ✅ Speed: No network latency (~100-500ms responses)
# ✅ Cost: Zero API charges, unlimited usage
# ✅ Offline: Works without internet connection
#
# When Chrome AI is not available, the app automatically falls back to
# server-side Gemini API (requires backend configuration)
# =============================================================================
