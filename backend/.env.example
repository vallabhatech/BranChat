# =============================================================================
# BRANCHAT BACKEND CONFIGURATION
# =============================================================================

# Environment
NODE_ENV=development
PORT=3001

# =============================================================================
# CHROME BUILT-IN AI - PRIMARY AI PROVIDER (CLIENT-SIDE)
# =============================================================================
# BranChat primarily uses Chrome's Built-in AI APIs on the client-side:
#
# 1. Prompt API (window.ai.languageModel)
#    - Used for: All conversation responses in main and branch chats
#    - Benefits: Privacy (on-device), Speed (no network), Cost (free)
#    - Location: frontend/src/lib/chromeAI.ts
#
# 2. Summarizer API (window.ai.summarizer)
#    - Used for: Automatic branch summarization when merging
#    - Benefits: Instant key-points extraction, no manual work
#    - Location: frontend/src/lib/chromeAI.ts
#
# 3. Writer API (window.ai.writer)
#    - Used for: Generating conversation starters
#    - Benefits: Creative content generation on-device
#    - Location: frontend/src/components/ConversationStarters.tsx
#
# NO API KEYS NEEDED FOR CHROME AI - It runs entirely on the user's device!
#
# Requirements (User's Browser):
# - Chrome 127+ (Canary, Dev, or Beta)
# - Enable chrome://flags/#optimization-guide-on-device-model
# - Enable chrome://flags/#prompt-api-for-gemini-nano
# - Restart Chrome (Gemini Nano downloads automatically)
# =============================================================================

# =============================================================================
# GEMINI AI - FALLBACK PROVIDER (SERVER-SIDE)
# =============================================================================
# This backend uses Google's Gemini API as a FALLBACK when:
# - User's browser doesn't support Chrome Built-in AI
# - User is on mobile or non-Chrome browser
# - Chrome AI is temporarily unavailable
#
# Get your API key: https://makersuite.google.com/app/apikey
# =============================================================================

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_EMBEDDING_MODEL=text-embedding-004

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB - Stores conversations, messages, users
MONGODB_URI=mongodb://localhost:27017/branchat
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/branchat

# Elastic Search (Optional - for semantic memory features)
ELASTIC_URL=http://localhost:9200
# For Elastic Cloud: https://your-deployment.es.region.cloud.es.io:9243
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=your-elastic-password
# Alternative: Use API key instead of username/password
# ELASTIC_API_KEY=your-elastic-api-key

# AI Settings
MAX_TOKENS=2000
TEMPERATURE=0.7

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Guest Mode
ALLOW_GUEST=true

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Memory Settings
MEMORY_TOP_K=5
MEMORY_SIMILARITY_THRESHOLD=0.7

# Admin (optional)
ADMIN_API_KEY=your-admin-api-key