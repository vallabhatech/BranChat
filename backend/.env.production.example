# =============================================================================
# BRANCHAT BACKEND CONFIGURATION
# =============================================================================

# Environment
NODE_ENV=development
PORT=3001

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB - Stores conversations, messages, users (REQUIRED)
MONGODB_URI=mongodb://localhost:27017/branchat
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/branchat

# Elastic Search (OPTIONAL - for semantic memory features)
# Leave empty to disable memory features
ELASTIC_URL=http://localhost:9200
# For Elastic Cloud: https://your-deployment.es.region.cloud.es.io:9243
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=your-elastic-password
# Alternative: Use API key instead of username/password
# ELASTIC_API_KEY=your-elastic-api-key

# =============================================================================
# AI CONFIGURATION
# =============================================================================

# Google Gemini API (OPTIONAL - fallback when Chrome AI unavailable)
# Leave empty to rely solely on Chrome Built-in AI APIs
# Get your API key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_EMBEDDING_MODEL=text-embedding-004

# AI Settings
MAX_TOKENS=2000
TEMPERATURE=0.7

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Authentication (REQUIRED)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Guest Mode
ALLOW_GUEST=true

# CORS (Update for your frontend domain in production)
CORS_ORIGIN=http://localhost:5173

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Logging
LOG_LEVEL=info

# =============================================================================
# MEMORY SETTINGS (OPTIONAL)
# =============================================================================

# Memory Settings (only used if Elasticsearch is configured)
MEMORY_TOP_K=5
MEMORY_SIMILARITY_THRESHOLD=0.7

# =============================================================================
# ADMIN SETTINGS (OPTIONAL)
# =============================================================================

# Admin (optional - for admin endpoints)
ADMIN_API_KEY=your-admin-api-key
